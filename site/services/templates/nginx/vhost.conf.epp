server {
    listen 443 ssl;
    http2 on;

    server_name <%= $name %>.<%= $base %> <% if $name == 'www' { -%><%= $base %><% } -%>;

    error_log  /var/log/nginx/<%= $name %>.<%= $base %>_error.log error;
    access_log /var/log/nginx/<%= $name %>.<%= $base %>_access.log;

    include <%= $project %>.d/<%= $name %>.conf;
    include <%= $project %>.d/ssl.conf;

    # Block access to sensitive dot-files and VCS folders (global rule applied to every vhost)
    include snippets/block-dotfiles.conf;

    <% if $gzip == true { -%>
    include conf.d/01-gzip.conf;
    <% } -%>

    <% if $perf == true { -%>
    include conf.d/01-perf.conf;
    <% } -%>

    <% if $static == true { -%>
    include snippets/static.conf;
    <% } -%>
}
