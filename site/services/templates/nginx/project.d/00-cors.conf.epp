# Allow CORS request from Hub to Forum
map $http_origin $<%= $cors %>_cors_orig {
    default                                     "https://<%= $base %>";
    "~^https:\/\/([^.]+)\.<%= regsubst($base, '\.', '\\.', 'G') %>$" $http_origin;
}

# Allow to pass cookies in CORS from Hub to Forum
map $http_origin $<%= $cors %>_cors_cred {
    default                                    false;
    "~^https:\/\/([^.]+)\.<%= regsubst($base, '\.', '\\.', 'G') %>$" true;
}
